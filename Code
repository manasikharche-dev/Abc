facts = {"raining"}
initial_facts = facts.copy()

rules = {
    "raining": "road wet",
    "road wet": "road slippery"
}

print("Initial Facts:", facts)

# Forward Chaining
print("\nForward Chaining")

new_fact = True

while new_fact:
    new_fact = False

    for condition, result in rules.items():
        if condition in facts and result not in facts:
            print("Rule fired:", condition, "->", result)
            facts.add(result)
            new_fact = True

print("\nFacts after Forward Chaining:", facts)

# Backward Chaining
print("\nBackward Chaining")

def backward(goal):
    print("Checking goal:", goal)

    if goal in initial_facts:
        print(goal, "is a fact")
        return True

    for condition, result in rules.items():
        if result == goal:
            print("Using rule:", condition, "->", result)

            if backward(condition):
                return True

    return False


goal = "road slippery"

if backward(goal):
    print("\nGoal", goal, "can be proved.")
else:
    print("\nGoal", goal, "cannot be proved.")


