import pandas as pd
import matplotlib.pyplot as plt
from sklearn.datasets import make_blobs
from sklearn.cluster import KMeans, AgglomerativeClustering
from sklearn.preprocessing import StandardScaler
from scipy.cluster.hierarchy import dendrogram, linkage

X, _ = make_blobs(n_samples=200, centers=5, random_state=42)
X = StandardScaler().fit_transform(X)

df = pd.DataFrame(X, columns=['Annual Income', 'Spending Score'])

wcss = []
for k in range(1, 11):
    model = KMeans(n_clusters=k, random_state=42, n_init=10)
    model.fit(X)
    wcss.append(model.inertia_)

plt.plot(range(1, 11), wcss, marker='o')
plt.title("Elbow Method")
plt.xlabel("Number of Clusters")
plt.ylabel("WCSS")
plt.show()

kmeans = KMeans(n_clusters=5, random_state=42, n_init=10)
df['KMeans_Cluster'] = kmeans.fit_predict(X)

plt.scatter(X[:, 0], X[:, 1], c=df['KMeans_Cluster'], cmap='rainbow')
plt.title("K-Means Clustering")
plt.xlabel("Annual Income")
plt.ylabel("Spending Score")
plt.show()

Z = linkage(X, method='ward')
plt.figure(figsize=(10, 5))
dendrogram(Z, truncate_mode='lastp', p=30)
plt.title("Hierarchical Clustering Dendrogram")
plt.show()

hc = AgglomerativeClustering(n_clusters=5, linkage='ward')
df['Hierarchical_Cluster'] = hc.fit_predict(X)

plt.scatter(X[:, 0], X[:, 1], c=df['Hierarchical_Cluster'], cmap='rainbow')
plt.title("Hierarchical Clustering")
plt.xlabel("Annual Income")
plt.ylabel("Spending Score")
plt.show()

print("K-Means Cluster Analysis:")
print(df.groupby('KMeans_Cluster')[['Annual Income', 'Spending Score']].mean().round(2))

print("\nHierarchical Cluster Analysis:")
print(df.groupby('Hierarchical_Cluster')[['Annual Income', 'Spending Score']].mean().round(2))

